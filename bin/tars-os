#!/usr/bin/env bash
# tars os: manage the bootc OS image, defined by the Containerfile and built
# with a root podman build.
set -euo pipefail
root=$(dirname "$(dirname "$(readlink -f "$0")")")
tag=${TARS_TAG:-44}
image=${TARS_IMAGE:-localhost/tars:$tag}   # use ghcr.io/<user>/tars:44 once on GitHub
base_ref=quay.io/fedora-ostree-desktops/cosmic-atomic:$tag
pins=$root/digests.txt
manifest=$root/manifest.txt

# One rpm query format, so the manifest is stable and diffable.
rpm_qf='%{NAME}-%|EPOCH?{%{EPOCH}:}|%{VERSION}-%{RELEASE}.%{ARCH}\n'

usage() {
  cat <<USAGE
usage: tars os <command>

commands:
  bump      Move the base pin (digests.txt) to the current digest of :$tag
  build     Build the image into root's container storage, then record its
            installed RPMs in manifest.txt
  deploy    Stage the rebuilt image with "bootc upgrade" (reboot to apply)
  update    bump + build + show the package diff, then offer to deploy
  status    Show the deployment status
USAGE
}

die() { echo "tars os: $*" >&2; exit 1; }

# Print "<ref> <digest>" from digests.txt.
base_pin() {
  local ref digest
  [[ -f $pins ]] || die "no $pins; run 'tars os bump' first"
  read -r ref digest < <(grep -v '^#' "$pins" | grep .) || die "no pin in $pins"
  echo "$ref $digest"
}

bump() {
  (($# == 0)) || { usage >&2; exit 1; }
  local digest
  digest=$(skopeo inspect --format '{{.Digest}}' "docker://$base_ref")
  [[ $digest =~ ^sha256:[0-9a-f]{64}$ ]] || die "bad digest: '$digest'"
  {
    echo "# Pinned base image. Move it with: tars os bump"
    echo "# Format: <ref>  <digest>"
    echo
    printf '%-50s %s\n' "$base_ref" "$digest"
  } > "$pins.tmp"
  mv "$pins.tmp" "$pins"
  cat "$pins"
}

# Sorted installed RPMs of an image, without gpg keys.
rpms_of() {
  sudo podman run --rm --entrypoint rpm -e LC_ALL=C "$1" -qa --qf "$rpm_qf" \
    | grep -v '^gpg-pubkey-' | sort
}

build() {
  local ref digest changed
  read -r ref digest < <(base_pin)
  [[ $digest =~ ^sha256:[0-9a-f]{64}$ ]] || die "bad digest in $pins: '$digest'"

  # Root storage, because bootc reads root's containers-storage. --no-cache
  # because the package step's inputs don't change when the repos do, so a
  # cached layer would silently keep old versions.
  sudo podman build --pull=always --no-cache \
    --build-arg BASE="${ref%:*}@$digest" -t "$image" "$root"

  # Record what the build actually contains. This is output, never input.
  rpms_of "$image" > "$manifest.tmp"
  [[ -s $manifest.tmp ]] || die "empty package manifest"
  mv "$manifest.tmp" "$manifest"
  echo "wrote $(wc -l < "$manifest") packages to manifest.txt"

  # Floating packages can pull newer versions of packages the base ships
  # (e.g. glibc-devel forcing glibc). Report any base package that changed.
  changed=$(rpms_of "${ref%:*}@$digest" | comm -23 - "$manifest" || true)
  if [[ -n $changed ]]; then
    echo "tars os: warning: base packages replaced or upgraded by this build:" >&2
    sed 's/^/  /' <<< "$changed" >&2
  fi
}

# Stage the rebuilt image. This only follows the image this machine is already
# on; the one-off move onto it is `bootc switch` (see README).
deploy() { sudo bootc upgrade; }
status() { sudo bootc status; }

update() {
  local old ans=
  old=$(mktemp); trap 'rm -f "$old"' RETURN
  [[ -f $manifest ]] && cp "$manifest" "$old"   # else: empty, everything shows as new
  bump
  build
  echo "package changes:"
  diff -U0 "$old" "$manifest" | grep '^[+-][^+-]' || echo "  (none)"
  if [[ -t 0 ]]; then
    read -r -p "Deploy now? [y/N] " ans || true
  fi
  if [[ $ans == [yY]* ]]; then deploy; fi
}

cmd=${1:-}
case $cmd in
  bump|build|deploy|update|status) shift; "$cmd" "$@" ;;
  *) usage; [[ $cmd =~ ^(-h|--help|help)?$ ]] ;;
esac
