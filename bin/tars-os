#!/usr/bin/env bash
# tars os: manage the bootc OS image.
set -euo pipefail
root=$(dirname "$(readlink -f "$0")")
tag=${TARS_TAG:-44}
image=${TARS_IMAGE:-localhost/tars:$tag}   # use ghcr.io/<user>/tars:44 once on GitHub
base_ref=quay.io/fedora-ostree-desktops/cosmic-atomic:$tag
pins=$root/digests.txt

usage() {
  cat <<USAGE
usage: tars os <command>

commands:
  digests   Refresh the base pin in digests.txt
  build     Build the image into root's container storage
  deploy    Switch this machine to the built image (reboot to apply)
  status    Show the deployment status
USAGE
}

digests() {
  local d
  d=$(skopeo inspect --format '{{.Digest}}' "docker://$base_ref")
  [[ $d =~ ^sha256:[0-9a-f]{64}$ ]] || { echo "bad digest: '$d'" >&2; exit 1; }
  {
    echo "# Pinned images. Regenerate with: tars os digests"
    echo "# Format: <ref>  <digest>"
    echo
    printf '%-50s %s\n' "$base_ref" "$d"
  } > "$pins.tmp"
  mv "$pins.tmp" "$pins"
  cat "$pins"
}

build() {
  local ref digest
  read -r ref digest < <(grep -v '^#' "$pins" | grep .)
  sudo podman build --pull=always \
    --build-arg BASE="${ref%:*}@$digest" -t "$image" "$root"
}

deploy() { sudo bootc switch --transport containers-storage "$image"; }
status() { sudo bootc status; }

case ${1:-} in
  digests|build|deploy|status) "$1" ;;
  *) usage; [[ ${1:-} =~ ^(-h|--help|help)?$ ]] ;;
esac
