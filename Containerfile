# syntax=docker/dockerfile:1

# Fedora 44 COSMIC Atomic as a bootable OS image (bootc).
# BASE is supplied by `tars os build` from digests.txt (the single source of truth).
# The only other input is the exact RPM list in packages.txt, generated by
# `tars os digests`. Edit `want` in bin/tars-os, not that file.

ARG BASE
FROM ${BASE}

# C toolchain (gcc, mold, glibc headers) so rustup/cargo can link on the host.
COPY packages.txt /tmp/packages.txt
RUN grep -v '^#' /tmp/packages.txt | grep . \
      | xargs dnf install -y --setopt=install_weak_deps=False \
 && dnf clean all \
 && rm -f /tmp/packages.txt
